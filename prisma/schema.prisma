generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  name                 String?
  image                String?
  password             String
  copyItems            CopyItem[]
  driveFolders         DriveFolder[]
  driveFiles           DriveFile[]
  workspacesOwned      Workspace[]       @relation("workspaceOwner")
  workspaceMemberships WorkspaceMember[]
  workspaceInvites     WorkspaceInvite[] @relation("workspaceInvitee")
  workspaceInvitesSent WorkspaceInvite[] @relation("workspaceInviter")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

enum WorkspaceMemberRole {
  owner
  member
}

enum InviteStatus {
  pending
  accepted
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  ownerId      String
  owner        User              @relation("workspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  copyItems    CopyItem[]
  driveFolders DriveFolder[]
  driveFiles   DriveFile[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceMemberRole @default(member)
  joinedAt    DateTime            @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviteeId    String?
  invitee      User?        @relation("workspaceInvitee", fields: [inviteeId], references: [id])
  inviteeEmail String
  invitedById  String
  invitedBy    User         @relation("workspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  status       InviteStatus @default(pending)
  createdAt    DateTime     @default(now())
  acceptedAt   DateTime?

  @@index([workspaceId])
  @@index([inviteeEmail])
}

model CopyItem {
  id          String     @id @default(cuid())
  content     String     @db.Text
  title       String?
  fileName    String?
  fileSize    Int?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model DriveFolder {
  id          String        @id @default(cuid())
  name        String
  color       String?
  parentId    String?
  parent      DriveFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    DriveFolder[] @relation("FolderHierarchy")
  files       DriveFile[]
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isStarred   Boolean       @default(false)
  isTrash     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([parentId])
  @@index([createdAt])
}

model DriveFile {
  id          String       @id @default(cuid())
  name        String
  size        Int
  mimeType    String
  url         String       @db.Text
  storageType String       @default("local")
  storageKey  String?      @db.Text
  folderId    String?
  folder      DriveFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isStarred   Boolean      @default(false)
  isTrash     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([folderId])
  @@index([createdAt])
  @@index([mimeType])
}

